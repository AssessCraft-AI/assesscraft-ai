# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local development ONLY: show the 1-click demo personas (backend needs ENABLE_DEMO_AUTH=true).
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
